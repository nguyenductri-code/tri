#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
import numpy as np
import math
from tf_transformations import euler_from_quaternion
import time
class ControlNode(Node):
    def __init__(self):
        super().__init__("control_node")
        #tọa độ đích

        #tọa độ mong muốn
        self.new_leader_x = 2.0
        self.new_leader_y = 1.5
        self.new_leader = np.array([[self.new_leader_x], [self.new_leader_y]])
        self.leader = np.zeros((2,1))
        self.distance_1 = np.array([[0.4],[0.3]])

        #thông số điều khiển
        self.L = 0.5
        self.Kp = 0.5
        self.Ki = 0.01
        self.Kd = 0.05
        self.integral_err = np.zeros((2,1))
        self.derivative = None
        self.rotating_distance = np.zeros((2,1))
        self.last_time = self.get_clock().now()
        self.start_time = self.get_clock().now()
        self.timer = self.create_timer(0.1, self.update_leader_position)
      
        #tạo publisher
        self.odom_pub_1 = self.create_publisher(Twist, "/robot1/cmd_vel", 10)   
        #tạo subscriber (xủ lý ở trong hàm callback_odom)
       
        self.odom_sub_1 = self.create_subscription(Odometry,"/robot1/odom", self.callback_odom_1, 10)
                
        
    def update_leader_position (self):
        current_time = self.get_clock().now()
        duration = current_time - self.start_time 
        t = duration.nanoseconds / 1e9

        v_leader = 0.1
        leader_x = self.new_leader_x + v_leader * t
        leader_y = self.new_leader_y 
        self.new_leader = np.array([[leader_x], [leader_y]])

