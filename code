        self.is_leader_ready = True"""

    #bản chất hàm callback_odom chạy trong vòng lặp liên tục nên những lệnh trong hàm sẽ được chạy lặp đi lặp lại
    def callback_odom_1 (self, msg: Odometry):#vì callback_odom là hàm xủ lý cho subscriber->tin nhắn mà nó nhận sẽ là kiểu Odometry
        #lệnh lấy tọa độ của robot
        follower_x = msg.pose.pose.position.x
        follower_y = msg.pose.pose.position.y
        follower_1 = np.array([[follower_x], [follower_y]])

        #sai số
        h_des = self.new_leader - self.distance_1
        e_1 = h_des - follower_1

        #tính khoảng thời gian
        now = self.get_clock().now()
        duration = now - self.last_time
        dt = duration.nanoseconds / 1e9

        #tính tích phân
        if dt > 0:
            self.integral_err = self.integral_err + (e_1 * dt)
            max_integral = 1.0  # tùy chỉnh theo hệ thống
            self.integral_err = np.clip(self.integral_err, -max_integral, max_integral)
           
        #tính đạo hàm
        e_dot = np.zeros((2,1))
        if (dt > 0) and (self.derivative is not None) :
            new_e = e_1 - self.derivative
            e_dot = new_e/dt
            

        #lệnh in sai số hiện tại
        self.get_logger().info(f"Robot1 --> e_x_1={e_1[0,0]:.3f} m, e_y_1={e_1[1,0]:.3f} m")

        #xử lý góc xoay
        q = msg.pose.pose.orientation
        quaternion_list = [q.x,q.y,q.z,q.w]
        roll, pitch, theta = euler_from_quaternion(quaternion_list)

        u,r = self.control_law(theta, e_1, e_dot)

        #ép kiểu tin nhắn cho publisher
        cmd_vel = Twist()
        #setup vận tốc+vận tốc góc cho robot
        cmd_vel.linear.x = float(np.clip(u, -0.3, 0.3))
        cmd_vel.angular.z = float(np.clip(r, -1.0, 1.0))
        #publish 
        self.odom_pub_1.publish(cmd_vel) 

        #update lại số liệu tính toán
        self.derivative = e_1
        self.last_time = now
        
    def control_law(self, theta, e, e_dot):
        b1 = np.array([[math.cos(theta)], [math.sin(theta)]])
        b2 = np.array([[-math.sin(theta)], [math.cos(theta)]])
        B = np.hstack((b1, self.L*b2))

        control = np.linalg.inv(B) @ (self.Kp * e + self.Ki * self.integral_err + self.Kd * e_dot)
        u = control[0, 0]
        r = control[1, 0]
        return u, r
    
def main(args=None):
    rclpy.init(args=args)
    node = ControlNode()
    rclpy.spin(node)
    rclpy.shutdown()

if __name__ == "__main__":
    main()

